{
  "//": "OPTIONAL, Claude-only enforcement layer for the handoff kit. Copy the",
  "//hooks": "relevant block into your real .claude/settings.json to opt in. See docs/hooks.md.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hooks/progress-sync.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/hooks/verify-gate.sh"
          }
        ]
      }
    ]
  }
}
